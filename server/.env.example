# ── PathoNexa Server Environment ──────────────────────────────
# Copy this file to `.env` and adjust the values.

# Port the API listens on (the app connects to this port).
PORT=5000

# Persistent, transaction-capable MongoDB connection string. Use Atlas or a
# replica set; standalone MongoDB is rejected because financial/domain writes
# must not fall back to non-atomic behavior.
# Local replica set: mongodb://localhost:27017/pathonexa?replicaSet=rs0
# MongoDB Atlas:     mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pathonexa
MONGODB_URI=mongodb://localhost:27017/pathonexa?replicaSet=rs0

# MongoDB connection/recovery tuning. Atlas discovery can legitimately take
# longer than 4 seconds, especially after a cold start. Failed required
# connections stay fail-closed and retry with exponential backoff.
MONGODB_TIMEOUT_MS=15000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_RETRY_MS=3000
MONGODB_RETRY_MAX_MS=30000
# 4 avoids slow/broken IPv6 selection on many local and cloud networks. Use 0
# for automatic selection or 6 only on a verified IPv6 deployment.
MONGODB_FAMILY=4

# Use a random secret of at least 32 characters in production.
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# development | production
NODE_ENV=development

# Optional disposable adapter for isolated development only. Never enable in
# production because data is lost on restart. Automated tests enable it
# explicitly without reading this file.
ALLOW_IN_MEMORY=false

# Set true to log every MongoDB query (verbose; for debugging persistence).
MONGOOSE_DEBUG=false

# ── Business Configuration ────────────────────────────────────
# All values below are tunable without touching code. The app reads
# them via GET /api/config.

# Default doctor commission % applied when a doctor is added without
# an explicit commission (0–100).
DEFAULT_COMMISSION_PERCENT=10

# Maximum discount allowed on a report, as % of the invoice amount
# (0–100). Reports with a bigger discount are rejected by the API.
MAX_DISCOUNT_PERCENT=50

# Currency symbol used on receipts / seeded lab settings.
CURRENCY_SYMBOL=₹

# ── Subscription Plans ────────────────────────────────────────
# Free trial length in days.
TRIAL_DAYS=7

# Monthly plan price (INR) and validity in days.
MONTHLY_PLAN_PRICE=799
MONTHLY_PLAN_DAYS=30

# Yearly plan price (INR) and validity in days.
YEARLY_PLAN_PRICE=7999
YEARLY_PLAN_DAYS=365

# ── Auth ──────────────────────────────────────────────────────
# Current internal OTP used by the expiring, attempt-limited challenge flow.
# It is never returned by the API or displayed by the app.
INTERNAL_OTP=123456

# ── Payments (Razorpay) ───────────────────────────────────────
# Razorpay API key (publishable — sent to the app to open the checkout) and
# secret (server-only — used to create orders and verify signatures).
# Get these from https://dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated browser origins allowed in production. Native app requests
# do not send an Origin header. Use `*` to allow every origin (development /
# trusted environments only — reflects the request origin).
CORS_ORIGINS=*
