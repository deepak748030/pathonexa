# ── PathoNexa Server Environment ──────────────────────────────
# Copy this file to `.env` and adjust the values.

# Port the API listens on (the app connects to this port).
PORT=5000

# MongoDB connection string. Leave empty to run the server with the
# built-in in-memory store (great for a quick local demo).
# Local MongoDB:  mongodb://localhost:27017/pathonexa
# MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pathonexa
MONGODB_URI=mongodb://localhost:27017/pathonexa

# Secret used to sign JWT login tokens. Change this in production!
JWT_SECRET=change_this_to_a_long_random_secret

# development | production
NODE_ENV=development

# Seed demo patients/reports on first start (idempotent).
SEED_DEMO=true

# ── Business Configuration ────────────────────────────────────
# All values below are tunable without touching code. The app reads
# them via GET /api/config.

# Default doctor commission % applied when a doctor is added without
# an explicit commission (0–100).
DEFAULT_COMMISSION_PERCENT=10

# Maximum discount allowed on a report, as % of the invoice amount
# (0–100). Reports with a bigger discount are rejected by the API.
MAX_DISCOUNT_PERCENT=50

# Currency symbol used on receipts / seeded lab settings.
CURRENCY_SYMBOL=₹

# ── Subscription Plans ────────────────────────────────────────
# Free trial length in days.
TRIAL_DAYS=7

# Monthly plan price (INR) and validity in days.
MONTHLY_PLAN_PRICE=799
MONTHLY_PLAN_DAYS=30

# Yearly plan price (INR) and validity in days.
YEARLY_PLAN_PRICE=7999
YEARLY_PLAN_DAYS=365

# ── Auth ──────────────────────────────────────────────────────
# Demo OTP accepted at login (until a real SMS gateway is wired in).
DEMO_OTP=123456
