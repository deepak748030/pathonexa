{
  "expo": {
    "name": "PathoNexa New",
    "slug": "pathonexa-newapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pathonexa-new",
    "userInterfaceStyle": "light",
    "softwareKeyboardLayoutMode": "resize",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1467E8"
    },
    "android": {
      "package": "com.pathonexa.newapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1467E8"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pathonexa.newapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "newArchEnabled": true
  }
}
