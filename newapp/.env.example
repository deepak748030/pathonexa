# Public URL of the persistent PathoNexa server. `/api` is appended if omitted.
#
# Leave UNSET for local development — the app auto-detects the host: web/iOS
# simulator → http://localhost:5000/api, Android emulator → http://10.0.2.2:5000/api,
# and a physical phone on LAN → http://<your-PC-LAN-IP>:5000/api (from Metro's hostUri).
# Only set it explicitly when auto-detection is wrong (production deploy / proxy):
#EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
