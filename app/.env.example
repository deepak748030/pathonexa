# ── PathoNexa App Environment ─────────────────────────────────
# Copy this file to `.env` and adjust for your machine.

# Backend base URL (WITHOUT trailing slash).
#   Web / iOS simulator : http://localhost:5000/api
#   Android emulator    : http://10.0.2.2:5000/api
#   Physical phone      : http://<your-PC-LAN-IP>:5000/api
#
# If left unset the app auto-detects the right host (Metro hostUri →
# 10.0.2.2 on Android emulator → localhost everywhere else).
EXPO_PUBLIC_API_URL=http://localhost:5000/api
