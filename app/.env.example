# ── PathoNexa App Environment ─────────────────────────────────
# Copy this file to `.env` and adjust for your machine.

# Backend base URL (WITHOUT trailing slash).
#   Web / iOS simulator : http://localhost:5000/api
#   Android emulator    : http://10.0.2.2:5000/api
#   Physical phone      : http://<your-PC-LAN-IP>:5000/api
#
# IMPORTANT: leave this UNSET for auto-detection. Auto-detect resolves the
# right host per platform (Metro hostUri → 10.0.2.2 on Android emulator →
# localhost everywhere else), which is required for a physical phone on LAN.
# Only set it manually when auto-detection gets it wrong (e.g. behind a proxy).
#EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
